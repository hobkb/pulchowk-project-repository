# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
backend/venv/

# Environment Variables -- never commit real secrets.
.env
.env.*
# ...but the templates that document which variables are needed SHOULD be
# committed, so a fresh clone knows what to fill in.
!.env.example
!backend/.env.example
!frontend/.env.example

# Django
backend/media/*
backend/media/ingestion_pdfs/*.pdf
!backend/media/.gitkeep
backend/staticfiles/
db.sqlite3

# Local ingestion QA scratch space (confidential extracted content -- both
# the source PDFs and the debug JSON they extract to)
backend/local_ingestion_test/

# Logs
*.log

# Node.js
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDEs
.vscode/
.idea/

# OS Files
.DS_Store
Thumbs.db
*~

# Build
build/
dist/

# AI / ML
.cache/
.huggingface/
models/
checkpoints/

# Temporary
*.tmp
*.bak
*.swp

# VS Code "Local History" -- keeps timestamped copies of every edited file,
# INCLUDING .env, so committing it would publish secrets that .env itself
# correctly keeps out.
.history/

# Vite dependency cache (can appear outside frontend/ if a dev server is
# started from another directory).
.vite/
**/.vite/

*.pdf

client_secret*.json
*.apps.googleusercontent.com.json


.postman
redis.txt
postman
scripts/
notebook_outputs/

temporary.py


DESIGN.md
STATUS.md
skills-lock.json


.claude
.agents
# Ingestion merge bundles -- exported via export_bundle, exchanged between
# teammates outside git, and merged with import_bundle. Contains real
# project titles, abstracts, section text and source PDFs, so it must
# never be committed regardless of where it's created or unzipped.
bundle-*/
bundle-*.zip
*.bundle.zip

# ---------------------------------------------------------------------------
# Report sources
# ---------------------------------------------------------------------------
# The LaTeX report drafts and their rendered figures are written, compiled and
# submitted outside the codebase. They are large, they are regenerated often,
# and the compiled PDFs are build output rather than source.
project-report/
project_report_v2/

# ---------------------------------------------------------------------------
# Archives
# ---------------------------------------------------------------------------
# Nothing here needs a committed archive. The ones that turn up are ingestion
# bundles and zipped report folders, both of which carry project content.
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# ---------------------------------------------------------------------------
# Local maintenance scripts and their working lists
# ---------------------------------------------------------------------------
# One-off scripts written to repair or migrate local data. They are not part
# of the application and they assume a particular local database state.
#
# files.txt is confidential as well as local: it lists source report
# filenames, and a report filename echoes the project title, so it falls under
# the same rule as the PDFs themselves.
backend/files.txt
backend/move_files.py
backend/completed_files.py
backend/assign_supervisor.py

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
# The notebook itself is tracked, but its checkpoints are not. Clear the cell
# outputs before committing: a debug notebook run against the corpus stores
# extracted project text in its output cells.
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Evaluation reports
# ---------------------------------------------------------------------------
# Generated by `manage.py search_eval`. Aggregate metrics only, no project
# content, but regenerated output rather than source. Commit a specific run
# deliberately if you want it as evidence in the report.
eval_reports/
