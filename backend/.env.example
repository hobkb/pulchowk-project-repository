# Copy to .env. These defaults work with `docker compose up -d` from the repo
# root; only GOOGLE_CLIENT_ID has to be filled in. Never commit the real .env.

# Development only. Generate a real key for any shared or production deploy:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=True
# Comma-separated. Empty ALLOWED_HOSTS is fine while DEBUG=True; CORS defaults
# to the Vite and CRA dev servers when unset.
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL with pgvector. docker-compose.yml publishes it on port 5433.
DB_NAME=pulchowk
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# OAuth 2.0 Web client ID from Google Cloud Console; same value as the
# frontend's VITE_GOOGLE_CLIENT_ID. See README.md, "Google sign-in".
GOOGLE_CLIENT_ID=

# Redis from docker-compose.yml.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
TIMEZONE=UTC

# Restricts Google sign-in. Keep it at the campus domain; add others only
# for local testing.
ALLOWED_LOGIN_DOMAINS=pcampus.edu.np
