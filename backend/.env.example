# Copy to .env and fill in. Never commit the real .env.
#
# ALLOWED_LOGIN_DOMAINS restricts Google sign-in. Keep it at the campus
# domain; add others only for local testing.

SECRET_KEY=
DEBUG=True
# Comma-separated. Empty ALLOWED_HOSTS is fine while DEBUG=True; CORS defaults
# to the Vite and CRA dev servers when unset.
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DB_NAME=pulchowk
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
GOOGLE_CLIENT_ID=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
TIMEZONE=
ALLOWED_LOGIN_DOMAINS=pcampus.edu.np
