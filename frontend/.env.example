# Copy to .env. Never commit the real .env.

# OAuth 2.0 Web client ID; same value as GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=

# /api/ goes through the Vite dev-server proxy to the backend (same origin,
# so auth cookies and the PDF preview just work). The proxy targets
# http://localhost:8000 unless VITE_BACKEND_URL is set.
VITE_API_BASE_URL=/api/
